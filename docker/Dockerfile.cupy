# CuPy test environment for lssem3d, aarch64 + CUDA (NVIDIA DGX Spark GB10).
#
# DELIBERATELY MINIMAL AND TORCH-FREE.  The torch port has its own container;
# keeping this one independent is the point -- if both backends agree on the
# validation ladder, that agreement means something only when they cannot
# share a code path or a library by accident.
#
#   docker build -f docker/Dockerfile.cupy -t lssem-cupy:latest .
#   docker run --rm --gpus all -v "$PWD":/work -w /work lssem-cupy:latest \
#          python -m pytest lssem3d/tests -q
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# venv rather than --break-system-packages: PEP 668 marks the system python
# as externally managed on 24.04, and a venv keeps the layer reproducible.
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# cupy-cuda13x matches the DGX Spark driver (580.x / CUDA 13.0).  The [ctk]
# extra is NOT optional here: CuPy JIT-compiles its elementwise kernels at
# first use and therefore needs the CUDA *headers* at run time.  Without it
# the image builds and imports cleanly, then dies on the first arithmetic op
# with "Failed to find CUDA headers" -- a failure that only appears once real
# work starts, which is the worst kind.  The nvidia container runtime injects
# the driver at `docker run --gpus all`; the headers come from the wheel.
RUN pip install --upgrade pip \
    && pip install numpy scipy matplotlib pytest "cupy-cuda13x[ctk]"

WORKDIR /work
CMD ["python", "-c", "import cupy; print('cupy', cupy.__version__, 'devices', cupy.cuda.runtime.getDeviceCount())"]
